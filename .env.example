# Get this from @BotFather on Telegram (see README.md for steps)
TELEGRAM_BOT_TOKEN=

# Optional: cron expression for the daily digest (default: 13:00 UTC)
# REMINDER_CRON=0 13 * * *

# Optional: IANA timezone for REMINDER_CRON, e.g. America/New_York (default: UTC)
# REMINDER_TZ=

# Optional: how many days ahead counts as "due soon" for tasks (default: 3)
# REMINDER_TASK_WINDOW_DAYS=3

# Optional: how many days ahead counts as "upcoming" for ASU effective dates (default: 30)
# REMINDER_ASU_WINDOW_DAYS=30
