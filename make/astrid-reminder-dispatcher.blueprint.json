{
  "flow": [
    {
      "id": 1,
      "mapper": {
        "filter": [
          [
            {
              "a": "status",
              "b": "pending",
              "o": "text:equal"
            },
            {
              "a": "remind_at",
              "b": "{{now}}",
              "o": "date:lessorequal"
            }
          ]
        ]
      },
      "module": "datastore:SearchRecord",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      },
      "parameters": {
        "datastore": 140071
      }
    },
    {
      "id": 2,
      "mapper": {
        "text": "{{1.data.text}}",
        "chatId": "{{1.data.target_chat_id}}"
      },
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "parameters": {
        "__IMTCONN__": 10719081
      }
    },
    {
      "id": 3,
      "mapper": {
        "key": "{{1.key}}"
      },
      "module": "datastore:DeleteRecord",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "parameters": {
        "datastore": 140071
      }
    }
  ],
  "name": "Astrid - Reminder Dispatcher",
  "metadata": {
    "instant": false,
    "version": 1
  },
  "scheduling": {
    "type": "indefinitely",
    "interval": 1800
  }
}
