{
  "flow": [
    {
      "id": 1,
      "mapper": {
        "filter": [
          [
            {
              "a": "chat_id",
              "o": "exist"
            }
          ]
        ]
      },
      "module": "datastore:SearchRecord",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      },
      "parameters": {
        "datastore": 139287
      }
    },
    {
      "id": 2,
      "mapper": {
        "filter": [
          [
            {
              "a": "assignee_chat_id",
              "b": "{{1.data.chat_id}}",
              "o": "number:equal"
            },
            {
              "a": "status",
              "b": "done",
              "o": "text:notequal"
            },
            {
              "a": "due_date",
              "o": "exist"
            },
            {
              "a": "due_date",
              "b": "{{addDays(now; 3)}}",
              "o": "date:lessorequal"
            }
          ]
        ]
      },
      "module": "datastore:SearchRecord",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "parameters": {
        "datastore": 139289
      }
    },
    {
      "id": 3,
      "mapper": {
        "entry": "{{2.data.task_id}}: {{2.data.title}} (due {{formatDate(2.data.due_date; \"YYYY-MM-DD\")}})"
      },
      "module": "builtin:BasicAggregator",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "parameters": {
        "feeder": 2
      }
    },
    {
      "id": 6,
      "filter": {
        "name": "Has something to report",
        "conditions": [
          [
            {
              "a": "{{3.array}}",
              "b": "0",
              "o": "array:greater"
            }
          ]
        ]
      },
      "mapper": {
        "text": "📋 Daily task digest\n\nYour tasks needing attention: {{ifempty(join(map(3.array; \"entry\"); \"; \"); \"none 🎉\")}}",
        "chatId": "{{1.data.chat_id}}"
      },
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      },
      "parameters": {
        "__IMTCONN__": 10541339
      }
    }
  ],
  "name": "Personal Assistant - Task Digest",
  "metadata": {
    "instant": false,
    "version": 1
  },
  "scheduling": {
    "time": "08:00",
    "type": "daily"
  }
}
