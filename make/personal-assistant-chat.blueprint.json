                      "module": "datastore:SearchRecord",
                      "version": 1,
                      "metadata": { "designer": { "x": 1800, "y": 500 } },
                      "parameters": { "datastore": 139287 }
                    },
                    {
                      "id": 60,
                      "mapper": { "chat_id": "{{59.chat_id}}", "username": "{{59.username}}" },
                      "module": "builtin:BasicAggregator",
                      "version": 1,
                      "metadata": { "designer": { "x": 2000, "y": 500 } },
                      "parameters": { "feeder": 59 }
                    },
                    {
                      "id": 61,
                      "mapper": {},
                      "module": "builtin:BasicRouter",
                      "routes": [
                        {
                          "flow": [
                            {
                              "id": 62,
                              "filter": { "name": "Assignee found", "conditions": [[{ "a": "{{60.array[1].chat_id}}", "o": "exist" }]] },
                              "mapper": {
                                "key": "{{6.assign_task}}",
                                "data": {
                                  "updated_at": "{{now}}",
                                  "assignee_chat_id": "{{60.array[1].chat_id}}",
                                  "assignee_username": "{{60.array[1].username}}"
                                },
                                "upsert": false
                              },
                              "module": "datastore:UpdateRecord",
                              "version": 1,
                              "metadata": { "designer": { "x": 2400, "y": 450 } },
                              "parameters": { "datastore": 139289 }
                            },
                            {
                              "id": 63,
                              "mapper": { "text": "👍 Assigned {{6.assign_task}} to @{{60.array[1].username}}.", "chatId": "{{1.message.chat.id}}" },
                              "module": "telegram:SendReplyMessage",
                              "version": 1,
                              "metadata": { "designer": { "x": 2700, "y": 450 } },
                              "parameters": { "__IMTCONN__": 10541339 }
                            }
                          ]
                        },
                        {
                          "flow": [
                            {
                              "id": 64,
                              "filter": { "name": "Assignee not found", "conditions": [[{ "a": "{{60.array[1].chat_id}}", "o": "notexist" }]] },
                              "mapper": {
                                "text": "{{6.assignee}} hasn't messaged this bot yet, so I can't assign {{6.assign_task}} to them. Ask them to send this bot a message first.",
                                "chatId": "{{1.message.chat.id}}"
                              },
                              "module": "telegram:SendReplyMessage",
                              "version": 1,
                              "metadata": { "designer": { "x": 2400, "y": 550 } },
                              "parameters": { "__IMTCONN__": 10541339 }
                            }
                          ]
                        }
                      ],
                      "metadata": { "designer": { "x": 2200, "y": 500 } },
                      "parameters": {}
                    }
                  ]
                }
              ],
              "version": 1,
              "metadata": { "designer": { "x": 1500, "y": -100 } },
              "parameters": {}
            }
          ]
        },
        {
          "flow": [
            {
              "id": 9,
              "filter": {
                "name": "Reply is plain text",
                "conditions": [[{ "a": "{{last(map(4.content; \"text\"; \"type\"; \"text\"))}}", "b": "{", "o": "text:notcontain" }]]
              },
              "mapper": { "text": "{{last(map(4.content; \"text\"; \"type\"; \"text\"))}}", "chatId": "{{1.message.chat.id}}" },
              "module": "telegram:SendReplyMessage",
              "version": 1,
